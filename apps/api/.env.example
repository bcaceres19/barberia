# Copie a .env.local (ignorado por git) y complete los valores. Nunca versione secretos.
APP_ENVIRONMENT=local
APP_DATABASE_URL=
APP_WORKER_DATABASE_URL=
APP_AUTH_HMAC_SECRET=

# Meta WhatsApp Cloud API (DEC-066, DEC-123).
OTP_PROVIDER=meta
APP_META_WHATSAPP_API_VERSION=v24.0
APP_META_WHATSAPP_PHONE_NUMBER_ID=
APP_META_WHATSAPP_ACCESS_TOKEN=
# template (plantilla Authentication) o text (texto libre, DEC-124).
APP_META_WHATSAPP_MODE=template
APP_META_WHATSAPP_TEMPLATE_NAME=
APP_META_WHATSAPP_LANGUAGE_CODE=es
# Teléfonos E.164 separados por coma. Obligatoria con text en local/test; opcional en otros ambientes.
APP_META_WHATSAPP_TEST_RECIPIENTS=
# Reservadas para administrar plantillas y el webhook; el envío no las usa.
APP_META_WABA=
APP_META_ID=

APP_RESEND_API_KEY=
APP_RESEND_FROM_ADDRESS=
