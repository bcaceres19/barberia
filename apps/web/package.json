{
  "name": "@system-barbershop/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../../api/openapi/dist/openapi.yaml -o src/shared/api/generated/openapi.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.40",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.11.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.8"
  }
}
