# Go
apps/api/bin/
apps/api/coverage.out
apps/api/**/coverage.out
*.test

# Captura local de HU-007 (e2e/reto-telefonico.spec.ts): nunca contiene un
# código real de WhatsApp, solo el generado en pruebas locales/E2E
# (APP_PHONE_CHALLENGE_CAPTURE_FILE, restringido a local/test por
# cmd/api/main.go). No debe versionarse bajo ninguna circunstancia.
apps/api/.e2e-capture.json

# Node, Vue y Vite
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/coverage/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/test-results/
apps/web/.auth/

# OpenAPI
api/openapi/dist/

# graphify (grafo de conocimiento del repo; graphify-out/ se versiona,
# salvo lo siguiente, según su propia recomendación)
graphify-out/cost.json
graphify-out/cache/

# Salidas locales
tmp/
temp/
*.log
*.local

# Dumps y copias de bases de datos
*.dump
*.backup
*.sql.gz
